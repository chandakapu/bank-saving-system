{
  "info": {
    "name": "Bank Saving System",
    "_postman_id": "bank-saving-system-v1",
    "description": "Authenticated API collection for the Bank Saving System. Run Login first; Postman retains the session cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/api/v1",
      "type": "string"
    },
    {
      "key": "origin",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "admin_username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotency_key",
      "value": "replace-for-each-logical-operation",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.request.headers.upsert({ key: 'Origin', value: pm.collectionVariables.get('origin') });"]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}" }
          }
        },
        {
          "name": "Current session",
          "request": { "method": "GET", "url": "{{base_url}}/auth/session" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{base_url}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get all customers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers"
          }
        },
        {
          "name": "Get customer by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers/1"
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/customers",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\"\n}"
            }
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/customers/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso Updated\"\n}"
            }
          }
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/customers/1"
          }
        }
      ]
    },
    {
      "name": "Deposito Types",
      "item": [
        {
          "name": "Get all deposito types",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/deposito-types"
          }
        },
        {
          "name": "Get deposito type by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/deposito-types/1"
          }
        },
        {
          "name": "Create deposito type",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/deposito-types",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Deposito Platinum\",\n  \"yearly_return\": 0.0900\n}"
            }
          }
        },
        {
          "name": "Update deposito type",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/deposito-types/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Deposito Bronze Plus\",\n  \"yearly_return\": 0.0400\n}"
            }
          }
        },
        {
          "name": "Delete deposito type",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/deposito-types/1"
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Get all accounts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/accounts"
          }
        },
        {
          "name": "Get account by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/accounts/1"
          }
        },
        {
          "name": "Get accounts by customer",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/customers/1/accounts"
          }
        },
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/accounts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"deposito_type_id\": 2\n}"
            }
          }
        },
        {
          "name": "Update account",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/accounts/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deposito_type_id\": 3\n}"
            }
          }
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/accounts/1"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get transactions for account",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/accounts/1/transactions"
          }
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/accounts/1/deposit",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000000,\n  \"transaction_date\": \"2024-01-15\"\n}"
            }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/accounts/1/withdraw",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_date\": \"2024-07-15\"\n}"
            }
          }
        }
      ]
    }
  ]
}
