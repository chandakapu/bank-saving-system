            }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/accounts/1/withdraw",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_date\": \"2024-07-15\"\n}"
            }
          }
        }
      ]
    }
  ]
