DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bank_saving_system
DB_SSL=false
# Optional PEM CA bundle path. DB_SSL=true always verifies the server certificate.
DB_SSL_CA=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
PORT=3000
ADMIN_USERNAME=admin
# Minimum 12 characters. Set this only in your secret store.
ADMIN_PASSWORD=
# Set true for one deployment to rotate the bootstrap admin password and revoke sessions.
ADMIN_ROTATE_PASSWORD=false
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
